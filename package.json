{
  "name": "nxtupdate-website",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run test && bun run typecheck && bun run validate:html && bun run deploy:dry",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "docs:dev": "bunx @upstash/docs7@latest dev ./docs",
    "test": "bun test",
    "typecheck": "wrangler types --include-runtime=false --check && tsc --noEmit",
    "validate:html": "bunx html-validate@latest public/index.html"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@cloudflare/workers-types": "5.20260904.1",
    "typescript": "7.0.2",
    "wrangler": "4.129.0"
  }
}

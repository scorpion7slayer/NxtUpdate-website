{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nxtupdate-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/docs", "/docs/*"]
  },
  "routes": [
    {
      "pattern": "nxtupdate.nxtaigen.com",
      "custom_domain": true
    }
  ]
}
